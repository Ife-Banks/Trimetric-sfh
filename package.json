{
  "name": "shf",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:rls": "node --env-file=.env.local scripts/verify-rls.mjs",
    "test": "vitest run",
    "test:ocr": "vitest run -c vitest.ocr.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:all": "npm run typecheck && npm run lint && npm test",
    "audit:high": "npm audit --audit-level=high",
    "publish:gmo": "node scripts/build-publish-gmo-v1.1.mjs && node scripts/verify-publish-sql.mjs",
    "palette:check": "node scripts/tokenize-palette.mjs --check",
    "palette:apply": "node scripts/tokenize-palette.mjs",
    "lookup:status": "node --env-file=.env.local scripts/lookup-config-status.mjs",
    "ocr:assets": "node scripts/fetch-ocr-assets.mjs"
  },
  "dependencies": {
    "@figma/code-connect": "^2.0.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
