# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# vitest cache
/node_modules/.vite
/vitest-result*.json
# Playwright artifacts — traces and videos are large and per-run
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# debug / logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# editor / IDE — local workspace state, not shared project config
.idea/
.vscode/
*.swp
*.swo

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OCR language assets — fetched by scripts/fetch-ocr-assets.mjs
# (eng.traineddata is ~23MB; vendored worker/core files ~17MB)
/eng.traineddata
/public/vendor/tesseract

# supabase CLI local state — machine-specific. Contains the linked project ref,
# pooler URL and component versions; never belongs in version control.
/supabase/.temp/
/supabase/.branches/

# agent / AI tool state — local machine state and downloaded reference material
# (linked project ids, Figma screenshots, full repo worktrees). Never application
# source, and never shared between clones.
/.kilo/
/.kilocode/
/.freebuff/
/.claude/
/.cursor/
/.windsurf/
/.continue/
/.aider*
