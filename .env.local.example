# Server-only (never NEXT_PUBLIC_). Fill with the service_role key from
# Supabase Dashboard → Project Settings → API.
#
# CI (.github/workflows/ci.yml) greps the production build output for this
# value and fails the build if it appears there. Never inline it into a client
# component or give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Require MFA (TOTP) on every admin/superadmin session.
# Leave false until an authenticator has been enrolled for EVERY admin account,
# then flip it to true — otherwise the first admin to sign in is locked out of
# their own review queue. When true, /api/admin/* returns 403 mfa_required for
# any session whose authenticator assurance level is below aal2.
ADMIN_MFA_REQUIRED=false
